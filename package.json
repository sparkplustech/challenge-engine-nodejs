{
  "name": "challenge-engine-nodejs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/scaffold-challenges.js && npm run dashboard:setup",
    "reset:workspace": "node scripts/reset-course-workspace.js",
    "readmes:refresh": "node scripts/refresh-challenge-readmes.js",
    "progress:update": "node scripts/update-progress.js",
    "readme:evidence": "node scripts/update-readme-evidence.js",
    "review:course": "node scripts/run-review-course.js",
    "review:challenge": "node scripts/run-review-challenge.js",
    "review:changed": "node scripts/run-review-changed.js",
    "review:all": "node scripts/run-review-all.js",
    "test": "node --test tests/*.test.js",
    "validate:structure": "node scripts/validate-structure.js",
    "health:check": "node scripts/health-check.js",
    "audit:topics": "node scripts/audit-topic-alignment.js",
    "ci:validate": "node scripts/ci-validate.js",
    "release:check": "npm run readmes:refresh && npm run health:check",
    "dashboard:setup": "npm --prefix dashboard install && npm --prefix dashboard/app install",
    "dashboard:api": "npm --prefix dashboard run dev",
    "dashboard:ui:dev": "npm --prefix dashboard/app run dev",
    "dashboard:build": "npm --prefix dashboard/app run build",
    "dashboard:dev": "concurrently -n api,ui -c cyan,magenta \"npm run dashboard:api\" \"npm run dashboard:ui:dev\"",
    "dashboard": "npm run dashboard:build && npm --prefix dashboard run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1"
  }
}
